// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

struct Body
{
    float3 position;
    float3 velocity;
    float mass;
};


RWStructuredBuffer<Body> bodies;
int bodiesCount;

float gravityConstant;
float constraint;
float dt;

float3 GetVelocityForBody(uint index)
{
    float3 position = bodies[index].position;
    float3 acceleration = 0;

    [loop]
    for (uint i = 0; i < (uint)bodiesCount; i++)
    {
        if (index == i)
        {
            continue;
        }

        float3 delta = bodies[i].position - position;
        float distance = max(length(delta), constraint);
        acceleration += gravityConstant * bodies[i].mass * delta / (distance * distance * distance);
    }

    return acceleration * dt;
}

#define THREAD_GROUP_SIZE 256

[numthreads(THREAD_GROUP_SIZE,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    // The last group can be partially filled, so skip threads past the end of the buffer.
    if (id.x >= (uint)bodiesCount)
    {
        return;
    }

    // Only the velocity is written. Positions and masses are read-only in this kernel,
    // so other threads can read them without any synchronization.
    bodies[id.x].velocity += GetVelocityForBody(id.x);
}
